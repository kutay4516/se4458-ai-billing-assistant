{
  "openapi": "3.0.3",
  "info": {
    "title": "Billing AI Agent",
    "version": "1.0.0",
    "description": "LLM tool-calling agent. Reached through the API Gateway at /api/v1/agent/chat."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/agent/chat": {
      "post": {
        "summary": "Ask the billing assistant (LLM tool calling -> MCP and/or REST via gateway)",
        "tags": [
          "Agent"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "additionalProperties": false,
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "conversationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "confirmActionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Action id from pendingConfirmation; confirms the staged payment"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  }
}
