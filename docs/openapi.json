    "/api/v1/pay": {
      "post": {
        "summary": "Pay Bill: record a simulated partial or full payment",
        "tags": [
          "Payments"
        ],
        "description": "No real card processing. Duplicate transaction IDs are rejected (409); amounts above the remaining balance are rejected (422).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscriberNo",
                  "month",
                  "year",
                  "amount",
                  "transactionId"
                ],
                "additionalProperties": false,
                "properties": {
                  "subscriberNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Subscriber number",
                    "example": "1001"
                  },
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12,
                    "example": 10
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 2000,
                    "maximum": 2100,
                    "example": 2026
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "example": 25.5
                  },
                  "transactionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "paidAmount": {
                      "type": "number"
                    },
                    "remainingBalance": {
                      "type": "number"
                    },
                    "billStatus": {
                      "type": "string"
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "transactionId": {
                          "type": "string"
                        },
                        "subscriberNo": {
                          "type": "string"
                        },
                        "month": {
                          "type": "integer"
                        },
                        "year": {
                          "type": "integer"
                        },
                        "amount": {
                          "type": "number"
