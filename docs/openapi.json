                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "JWT subscriber differs from the requested subscriber",
            "content": {
              "application/json": {
                "schema": {
                  "description": "JWT subscriber differs from the requested subscriber",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No calculated bill for the period",
            "content": {
              "application/json": {
                "schema": {
                  "description": "No calculated bill for the period",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
