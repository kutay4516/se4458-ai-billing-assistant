    "/api/v1/bill": {
      "get": {
        "summary": "Query Bill: total, paid amount, remaining balance and status (no authentication per assignment)",
        "tags": [
          "Billing"
        ],
        "description": "Public by assignment requirement. If an Authorization header is supplied it is validated and must belong to the same subscriber.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "example": "1001",
            "in": "query",
            "name": "subscriberNo",
            "required": true,
            "description": "Subscriber number"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "example": 10,
            "in": "query",
            "name": "month",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "example": 2026,
            "in": "query",
            "name": "year",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subscriberNo": {
                      "type": "string"
                    },
                    "month": {
                      "type": "integer"
                    },
                    "year": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "number"
                    },
                    "paidAmount": {
                      "type": "number"
                    },
                    "remainingBalance": {
                      "type": "number"
