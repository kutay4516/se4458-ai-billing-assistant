{
  "openapi": "3.0.3",
  "info": {
    "title": "Mobile Provider Billing API",
    "version": "1.0.0",
    "description": "Versioned REST API (/api/v1) for usage, billing and simulated payments. Public clients reach it through the API Gateway."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/auth/token": {
      "post": {
        "summary": "Exchange subscriber credentials for a JWT",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscriberNo",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "subscriberNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Subscriber number",
                    "example": "1001"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "tokenType": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer"
                    },
                    "subscriberNo": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Validation error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Invalid credentials",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usage": {
      "post": {
        "summary": "Add Usage: +10 minutes of phone or +1 MB of internet",
        "tags": [
          "Usage"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscriberNo",
                  "month",
                  "year",
                  "usageType"
                ],
                "additionalProperties": false,
                "properties": {
                  "subscriberNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Subscriber number",
                    "example": "1001"
                  },
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12,
                    "example": 10
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 2000,
                    "maximum": 2100,
                    "example": 2026
                  },
                  "usageType": {
                    "type": "string",
                    "enum": [
                      "Phone",
                      "Internet"
                    ]
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "subscriberNo": {
                      "type": "string"
                    },
                    "month": {
                      "type": "integer"
                    },
                    "year": {
                      "type": "integer"
                    },
                    "usageType": {
                      "type": "string"
                    },
                    "added": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Validation error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Missing or invalid JWT",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "JWT subscriber differs from the requested subscriber",
            "content": {
              "application/json": {
                "schema": {
                  "description": "JWT subscriber differs from the requested subscriber",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown subscriber",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Unknown subscriber",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bill/calculate": {
      "post": {
        "summary": "Calculate Bill: snapshot the period's usage into a persisted bill",
        "tags": [
          "Billing"
        ],
        "description": "Phone: first 1,000 minutes free, then $10 per started 1,000-minute block. Internet: $50 up to 20 GB, then $10 per started additional 10 GB block (1 GB = 1,000 MB).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subscriberNo",
                  "month",
                  "year"
                ],
                "additionalProperties": false,
                "properties": {
                  "subscriberNo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$",
                    "description": "Subscriber number",
                    "example": "1001"
                  },
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12,
                    "example": 10
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 2000,
                    "maximum": 2100,
                    "example": 2026
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "bill": {
                      "type": "object",
                      "properties": {
                        "subscriberNo": {
                          "type": "string"
                        },
                        "month": {
                          "type": "integer"
                        },
                        "year": {
                          "type": "integer"
                        },
                        "phoneMinutes": {
                          "type": "number"
                        },
                        "internetMb": {
                          "type": "number"
                        },
                        "internetGb": {
                          "type": "number"
                        },
                        "phoneCharge": {
                          "type": "number"
                        },
                        "internetBaseCharge": {
                          "type": "number"
                        },
                        "internetOverageCharge": {
                          "type": "number"
                        },
                        "internetCharge": {
                          "type": "number"
                        },
                        "total": {
                          "type": "number"
                        },
                        "paidAmount": {
                          "type": "number"
                        },
                        "remainingBalance": {
                          "type": "number"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "UNPAID",
                            "PARTIAL",
                            "PAID"
                          ]
                        },
                        "calculatedAt": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Validation error",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Missing or invalid JWT",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "JWT subscriber differs from the requested subscriber",
            "content": {
              "application/json": {
                "schema": {
                  "description": "JWT subscriber differs from the requested subscriber",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown subscriber",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Unknown subscriber",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {}
                      }
                    }
                  }
                }
              }
            }
