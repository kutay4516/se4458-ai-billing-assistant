            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "example": "1001",
            "in": "query",
            "name": "subscriberNo",
            "required": true,
            "description": "Subscriber number"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "example": 10,
            "in": "query",
            "name": "month",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "example": 2026,
            "in": "query",
            "name": "year",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "1-based page of usage records"
