# ---- Shared ----
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
# ---- Billing API ----
PORT=3000
# Leave unset to use the in-memory store (quick local look). docker compose sets it for you.
# DATABASE_URL=postgresql://billing:billing@localhost:5432/billing
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo!Pass2026
# ---- MCP server ----
MCP_PORT=3002
MCP_TRANSPORT=http
BILLING_GUIDE_PATH=Mobile_Provider_Billing_Guide.md
# ---- API Gateway ----
GATEWAY_PORT=3001
BILLING_API_URL=http://127.0.0.1:3000
AGENT_URL=http://127.0.0.1:3003
# ---- AI Agent ----
AGENT_PORT=3003
GATEWAY_URL=http://127.0.0.1:3001
GATEWAY_PUBLIC_URL=http://127.0.0.1:3001
MCP_URL=http://127.0.0.1:3002/mcp
# Any OpenAI-compatible provider. Low-cost default: Google Gemini free tier via its OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
